# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Credentials - never commit, never document
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.key

# ---------------------------------------------------------------------------
# Datasets (obtained separately, never redistributed from this repository)
# ---------------------------------------------------------------------------
# CubiCasa5K high_quality_architectural subset and anything derived from it.
docs/high_quality_architectural/
data/

# ---------------------------------------------------------------------------
# Model checkpoints (published via GitHub Releases, not via Git)
# ---------------------------------------------------------------------------
checkpoints/
checkpoints_CNN/
checkpoints_Raster2Graph/
*.pt
*.pth
*.ckpt
*.safetensors

# ---------------------------------------------------------------------------
# Generated experiment runs, caches, and scratch space
# ---------------------------------------------------------------------------
features/
runs/
tmp/
outputs/
*.log
# Written at runtime by src/train_segmentation.py --overfit
splits/_overfit_temp.json

# ---------------------------------------------------------------------------
# Local release bundle prepared for manual GitHub Release upload
# ---------------------------------------------------------------------------
dist/

# ---------------------------------------------------------------------------
# Demo assets generated from a pipeline run
# ---------------------------------------------------------------------------
# demo/ holds the static demo's source: the page, its stylesheet and script,
# and demo/build_demo_assets.py which regenerates everything below from
# outputs/vectorization/. The generated files are renderings of, and pipeline
# output derived from, CubiCasa5K, so they are not committed here - same rule
# as outputs/ and docs/high_quality_architectural/. Rebuild them with:
#     python demo/build_demo_assets.py
demo/assets/samples/
demo/assets/data.js

# ---------------------------------------------------------------------------
# Local scratch / reference material and editor state
# ---------------------------------------------------------------------------
code_sample/
.vscode/
.idea/
.agents/
.claude/settings.local.json
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Intentionally versioned (not matched by any rule above - listed so the policy
# is explicit rather than accidental)
# ---------------------------------------------------------------------------
#   docs/images/         curated README evidence: small, web-optimized, real
#                        pipeline output only
#   evaluation/results/  compact standardized metrics (JSON/CSV summaries only -
#                        never raw predictions, dataset copies, or checkpoints)
#   splits/              canonical train/validation/test manifests required for
#                        evaluation provenance
#   tests/               intentional lightweight test fixtures
/neural_floorplan_support
